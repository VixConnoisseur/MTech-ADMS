<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mtech.adms.controller.EmployeeFormController"
      spacing="16" styleClass="form-dialog" prefWidth="380">
    <padding>
        <Insets top="24" bottom="24" left="24" right="24"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Add Employee" styleClass="panel-title"/>

    <VBox spacing="6">
        <Label text="Full Name" styleClass="login-field-label"/>
        <TextField fx:id="fullNameField" promptText="e.g. Juan Dela Cruz" styleClass="login-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Position" styleClass="login-field-label"/>
        <TextField fx:id="positionField" promptText="e.g. Technician" styleClass="login-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Contact Number" styleClass="login-field-label"/>
        <TextField fx:id="contactField" promptText="e.g. 0917 123 4567" styleClass="login-field"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true"
           maxWidth="Infinity" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>

</VBox>