<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mtech.adms.controller.AssetStatusController"
      spacing="14" styleClass="form-dialog" prefWidth="380">
    <padding>
        <Insets top="24" bottom="24" left="24" right="24"/>
    </padding>

    <Label fx:id="titleLabel" text="Change Status" styleClass="panel-title"/>
    <Label fx:id="currentStatusLabel" text="Current status: —" styleClass="login-subtitle"/>

    <VBox spacing="6">
        <Label text="New Status" styleClass="login-field-label"/>
        <ComboBox fx:id="newStatusCombo" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Notes (optional)" styleClass="login-field-label"/>
        <TextArea fx:id="notesField" wrapText="true" prefRowCount="3" styleClass="login-field"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true"
           maxWidth="Infinity" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button fx:id="saveButton" text="Confirm Change" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>

</VBox>