<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mtech.adms.controller.AssetFormController"
      spacing="12" styleClass="form-dialog" prefWidth="420">
    <padding>
        <Insets top="24" bottom="24" left="24" right="24"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Add Asset" styleClass="panel-title"/>

    <VBox spacing="6">
        <Label text="Tool Name" styleClass="login-field-label"/>
        <TextField fx:id="toolNameField" promptText="e.g. Fluke Cable Tester" styleClass="login-field"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Serial Number" styleClass="login-field-label"/>
            <TextField fx:id="serialNumberField" promptText="e.g. FLK123456" styleClass="login-field"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Category" styleClass="login-field-label"/>
            <ComboBox fx:id="categoryComboBox" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Condition" styleClass="login-field-label"/>
            <ComboBox fx:id="conditionComboBox" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Purchase Date" styleClass="login-field-label"/>
            <DatePicker fx:id="purchaseDatePicker" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Purchase Cost" styleClass="login-field-label"/>
        <TextField fx:id="purchaseCostField" promptText="e.g. 2500.00" styleClass="login-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Notes" styleClass="login-field-label"/>
        <TextArea fx:id="notesField" wrapText="true" prefRowCount="2" styleClass="login-field"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true"
           maxWidth="Infinity" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>

</VBox>