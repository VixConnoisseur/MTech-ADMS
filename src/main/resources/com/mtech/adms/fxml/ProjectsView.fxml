<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mtech.adms.controller.ProjectsController"
      spacing="16">
    <padding>
        <Insets top="24" bottom="24" left="24" right="24"/>
    </padding>

    <VBox styleClass="panel-card" spacing="14" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="18" bottom="18" left="18" right="18"/>
        </padding>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search by name or project code..."
                       styleClass="header-search" prefWidth="320"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Add Project" onAction="#handleAddProject" styleClass="primary-button"/>
        </HBox>

        <TableView fx:id="projectsTable" styleClass="dashboard-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCode" text="Code" prefWidth="90"/>
                <TableColumn fx:id="colName" text="Project Name" prefWidth="200"/>
                <TableColumn fx:id="colClient" text="Client" prefWidth="140"/>
                <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="140"/>
            </columns>
        </TableView>

    </VBox>
</VBox>