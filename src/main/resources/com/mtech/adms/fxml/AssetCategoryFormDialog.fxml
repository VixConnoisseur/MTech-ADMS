<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mtech.adms.controller.AssetCategoryFormController"
      spacing="16" styleClass="form-dialog" prefWidth="380">
    <padding>
        <Insets top="24" bottom="24" left="24" right="24"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Add Category" styleClass="panel-title"/>

    <VBox spacing="6">
        <Label text="Category Name" styleClass="login-field-label"/>
        <TextField fx:id="nameField" promptText="e.g. Testing Equipment" styleClass="login-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Description" styleClass="login-field-label"/>
        <TextArea fx:id="descriptionField" promptText="Brief description of this category"
                  wrapText="true" prefRowCount="3" styleClass="login-field"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true"
           maxWidth="Infinity" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>

</VBox>